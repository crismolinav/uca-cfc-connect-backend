DB_URL=jdbc:mysql://localhost:3306/uca_cfc_connect
DB_USERNAME=root
DB_PASSWORD=
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Usar true cuando la aplicación se publique con HTTPS.
AUTH_COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
spring.profiles.active=google
CORS_ALLOWED_ORIGINS=http://localhost:3000
OAUTH2_SUCCESS_REDIRECT_URI=http://localhost:8080/auth/callback.html
OAUTH2_FAILURE_REDIRECT_URI=http://localhost:8080/auth/login.html
# Invitaciones: local muestra el enlace en recepción. Para enviar correos, usar smtp.
INVITATION_DELIVERY=local
INVITATION_BASE_URL=http://localhost:8080
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Credenciales del aplicativo Wompi de tu cuenta. Completar solo en el .env local; nunca subir credenciales.
# El callback debe ser público para que Wompi alcance el backend. Con Quick Tunnel, reemplaza el host cada vez que Cloudflare cambie la URL.
WOMPI_CLIENT_ID=
WOMPI_CLIENT_SECRET=
WOMPI_REDIRECT_URL=https://TU-TUNEL.trycloudflare.com/api/v1/cliente/pagos/wompi/retorno
# Después del callback público, el navegador vuelve a la app local donde inició sesión.
WOMPI_FRONTEND_RETURN_URL=http://localhost:8080/cliente/aprendizaje.html
WOMPI_ALLOW_TEST_PAYMENTS=true
WOMPI_ALLOW_PRODUCTION=false
